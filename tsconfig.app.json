{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "@lapis-notes/lapis-plugin-notebook": ["./src/lib/index.ts"],
      "@lapis-notes/notebook-core": ["./packages/core/src/index.ts"],
      "@lapis-notes/notebook-core/*": [
        "./packages/core/src/*/index.ts",
        "./packages/core/src/*"
      ],
      "@lapis-notes/notebook-stdlib": ["./packages/stdlib/src/index.ts"],
      "@lapis-notes/notebook-stdlib/*": [
        "./packages/stdlib/src/*/index.ts",
        "./packages/stdlib/src/*"
      ],
      "@lapis-notes/notebook-input": ["./packages/input/src/index.ts"],
      "@lapis-notes/notebook-input/*": [
        "./packages/input/src/*/index.ts",
        "./packages/input/src/*"
      ],
      "@lapis-notes/notebook-duckdb": ["./packages/duckdb/src/index.ts"],
      "@lapis-notes/notebook-duckdb/*": [
        "./packages/duckdb/src/*/index.ts",
        "./packages/duckdb/src/*"
      ],
      "@lapis-notes/notebook-duckdb-assets": [
        "./packages/duckdb-assets/src/index.ts"
      ],
      "@lapis-notes/notebook-duckdb-assets/*": [
        "./packages/duckdb-assets/src/*/index.ts",
        "./packages/duckdb-assets/src/*"
      ],
      "@lapis-notes/notebook-worker": ["./packages/worker/src/index.ts"],
      "@lapis-notes/notebook-worker/*": [
        "./packages/worker/src/*/index.ts",
        "./packages/worker/src/*"
      ],
      "svelte": ["./node_modules/svelte"],
      "svelte/*": ["./node_modules/svelte/*"]
    },
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": false,
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "packages/*/src/**/*.d.ts",
    "packages/*/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.stories.ts",
    "src/**/*.stories.svelte",
    "src/**/*.example-sources.ts",
    "src/**/*.story-play.ts",
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/__tests__/**"
  ]
}
