{
  "compilerOptions": {
    "paths": {
      "$lib": ["./src"],
      "$lib/*": ["./src/*"],
      "@lapis-notes/notebook-duckdb": ["./src/index.ts"],
      "@lapis-notes/notebook-duckdb/*": ["./src/*/index.ts", "./src/*"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
