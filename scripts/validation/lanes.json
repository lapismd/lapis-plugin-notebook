{
  "validation:all": "node scripts/validation/all.mjs",
  "build": "pnpm run prepack",
  "check": "pnpm check:validation-routing && pnpm check:storybook-parity && pnpm spec:validate && pnpm check:app-ownership && pnpm check:no-tailwind && pnpm check:svelte && pnpm check:types",
  "check:app-ownership": "vitest run --project unit src/lib/application-ownership.test.ts",
  "check:no-tailwind": "node scripts/check-no-tailwind.mjs",
  "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
  "check:types": "tsc -p tsconfig.node.json --noEmit",
  "test": "vitest run --project unit --passWithNoTests --maxWorkers=1 --no-file-parallelism",
  "test:storybook": "node scripts/test-storybook-batches.mjs",
  "build-storybook": "NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" storybook build --config-dir .storybook --output-dir storybook-static",
  "publint": "pnpm run prepack",
  "packages:pack": "node scripts/check-package-consumer.mjs",
  "prepack": "node scripts/build-npm-package.mjs",
  "spec:build": "spec-validator build",
  "spec:check": "pnpm check:validation-routing && pnpm check:storybook-parity && spec-validator check && pnpm check:app-ownership",
  "spec:first": "spec-validator first",
  "spec:validate": "spec-validator validate",
  "check:validation-routing": "node scripts/validation/check-routing.mjs",
  "check:storybook-parity": "node scripts/spec-validation/check-storybook-parity.mjs",
  "validation:check": "vitest run --project unit scripts/validation.test.mjs scripts/ci.test.mjs scripts/spec-validation/storybook-parity.test.mjs --maxWorkers=1 --no-file-parallelism",
  "validation:smoke": "node scripts/validation/smoke.mjs",
  "build:bundle": "node scripts/build-plugin-bundle.mjs && node scripts/check-bundle-exclusions.mjs",
  "storybook:review": "node scripts/validation/review-server.mjs",
  "test:canvas-tables": "vitest run --project unit src/lib/render/table packages/input/src/__tests__/table-model.test.ts scripts/validation/review.test.mjs scripts/validation.test.mjs src/lib/application-ownership.test.ts --maxWorkers=1 --no-file-parallelism",
  "check:canvas-table-types": "svelte-check --tsconfig ./tsconfig.canvas-review.json --fail-on-warnings",
  "registry:prepare": "pnpm build:bundle && node scripts/registry-release.mjs prepare",
  "registry:media:capture": "node scripts/registry-media.mjs",
  "registry:media:check": "node scripts/registry-media.mjs --check",
  "registry:check": "vitest run --project unit scripts/registry-*.test.mjs --maxWorkers=1 --no-file-parallelism"
}
