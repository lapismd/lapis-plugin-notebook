{
  "id": "lapis-notebook",
  "name": "Notebook",
  "version": "0.1.0",
  "minAppVersion": "0.0.1",
  "description": "Executable .notebook.md notebooks with reactive cells and rich outputs.",
  "author": "Lapis Notes",
  "distribution": "first-party-external",
  "provenance": "official",
  "enabledByDefault": false,
  "lapis": {
    "manifestVersion": 1,
    "runtime": {
      "entries": {
        "workspace": {
          "path": "main.mjs",
          "format": "esm",
          "sharedDependencies": [
            "@lapismd/design-core/chat",
            "@lapismd/design-core/shadcn/alert",
            "@lapismd/design-core/shadcn/badge",
            "@lapismd/design-core/shadcn/button",
            "@lapismd/design-core/shadcn/button-group",
            "@lapismd/design-core/shadcn/card",
            "@lapismd/design-core/shadcn/checkbox",
            "@lapismd/design-core/shadcn/code-block",
            "@lapismd/design-core/shadcn/command",
            "@lapismd/design-core/shadcn/dialog",
            "@lapismd/design-core/shadcn/dropdown-menu",
            "@lapismd/design-core/shadcn/field",
            "@lapismd/design-core/shadcn/file-type-icon",
            "@lapismd/design-core/shadcn/input",
            "@lapismd/design-core/shadcn/input-group",
            "@lapismd/design-core/shadcn/popover",
            "@lapismd/design-core/shadcn/progress",
            "@lapismd/design-core/shadcn/radio-group",
            "@lapismd/design-core/shadcn/scroll-area",
            "@lapismd/design-core/shadcn/select",
            "@lapismd/design-core/shadcn/separator",
            "@lapismd/design-core/shadcn/sheet",
            "@lapismd/design-core/shadcn/slider",
            "@lapismd/design-core/shadcn/switch",
            "@lapismd/design-core/shadcn/textarea",
            "@lapismd/design-core/shadcn/tooltip",
            "@lapismd/design-core/workspace/icon",
            "@codemirror/autocomplete",
            "@codemirror/commands",
            "@codemirror/lang-markdown",
            "@codemirror/language",
            "@codemirror/search",
            "@codemirror/state",
            "@codemirror/view",
            "@lapis-notes/api",
            "@lapis-notes/api/editor",
            "@lapis-notes/api/editor/core",
            "@lapis-notes/api/editor/language-service",
            "@lapis-notes/markdown",
            "@lapis-notes/ui",
            "@lapis-notes/ui/search",
            "@lezer/highlight",
            "svelte",
            "svelte/internal/client",
            "svelte/internal/disclose-version",
            "svelte/internal/flags/async",
            "svelte/internal/flags/legacy",
            "svelte/reactivity",
            "svelte/store",
            "svelte/transition"
          ],
          "requiresReloadOnUpdate": false
        }
      }
    },
    "permissions": [
      "vault.read",
      "vault.write",
      "vault.stream",
      "plugin.data",
      "plugin.generated-state",
      "commands",
      "notices",
      "settings.read",
      "metadata.query",
      "metadata.changes",
      "network.connect",
      "events"
    ]
  }
}
