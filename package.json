{
  "name": "@lapis-notes/lapis-plugin-notebook",
  "version": "0.2.1",
  "description": "Executable .notebook.md notebooks with reactive cells and rich outputs for Lapis Notes",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-plugin-notebook.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/validation.mjs run build",
    "check": "node scripts/validation.mjs run check",
    "check:app-ownership": "node scripts/validation.mjs run check:app-ownership",
    "check:no-tailwind": "node scripts/validation.mjs run check:no-tailwind",
    "check:svelte": "node scripts/validation.mjs run check:svelte",
    "check:types": "node scripts/validation.mjs run check:types",
    "test": "node scripts/validation.mjs run test",
    "test:storybook": "node scripts/validation.mjs run test:storybook",
    "build-storybook": "node scripts/validation.mjs run build-storybook",
    "publint": "node scripts/validation.mjs run publint",
    "packages:pack": "node scripts/validation.mjs run packages:pack",
    "prepack": "node scripts/validation.mjs run prepack",
    "spec:build": "node scripts/validation.mjs run spec:build",
    "spec:check": "node scripts/validation.mjs run spec:check",
    "spec:first": "node scripts/validation.mjs run spec:first",
    "spec:index": "spec-validator index",
    "spec:search": "spec-validator search",
    "spec:validate": "node scripts/validation.mjs run spec:validate",
    "storybook": "WATCHPACK_POLLING=250 node scripts/storybook-run.mjs --no-open --config-dir .storybook",
    "storybook:stop": "bash scripts/storybook-stop.sh",
    "storybook:restart": "bash scripts/storybook-restart.sh",
    "check:validation-routing": "node scripts/validation.mjs run check:validation-routing",
    "check:storybook-parity": "node scripts/validation.mjs run check:storybook-parity",
    "validation:check": "node scripts/validation.mjs run validation:check",
    "validation:all": "node scripts/validation.mjs run validation:all",
    "validation:smoke": "node scripts/validation.mjs run validation:smoke",
    "validation": "node scripts/validation.mjs",
    "validation:doctor": "node scripts/validation.mjs doctor",
    "validation:images": "node scripts/validation.mjs images",
    "validation:clean": "node scripts/validation.mjs clean",
    "build:bundle": "node scripts/validation.mjs run build:bundle",
    "storybook:review": "node scripts/validation.mjs run storybook:review",
    "test:canvas-tables": "node scripts/validation.mjs run test:canvas-tables",
    "check:canvas-table-types": "node scripts/validation.mjs run check:canvas-table-types",
    "registry:prepare": "node scripts/validation.mjs run registry:prepare",
    "registry:media:capture": "node scripts/validation.mjs run registry:media:capture",
    "registry:media:check": "node scripts/validation.mjs run registry:media:check",
    "registry:check": "node scripts/validation.mjs run registry:check",
    "registry:sign": "node scripts/registry-release.mjs sign",
    "registry:publish": "node scripts/registry-release.mjs publish"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.stories.*",
    "!dist/**/*.example-sources.*",
    "!dist/**/*.story-play.*",
    "manifest.json",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/main.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/main.mjs",
      "import": "./dist/main.mjs",
      "default": "./dist/main.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-sql": "^6.9.1",
    "@duckdb/duckdb-wasm": "1.33.1-dev45.0",
    "@lezer/highlight": "1.2.3",
    "@lucide/svelte": "^0.523.0",
    "@tanstack/svelte-virtual": "^3.13.12",
    "@tanstack/table-core": "^8.21.3",
    "date-fns": "^4.1.0",
    "vega-embed": "^7.1.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lapis-notes/api": "^0.2.4",
    "@lapis-notes/markdown": "^0.2.1",
    "@lapis-notes/ui": "^0.1.6",
    "@lapismd/design-core": "^0.9.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/source-code-pro": "5.2.7",
    "@internationalized/date": "3.12.2",
    "@lapis-notes/api": "0.2.4",
    "@lapis-notes/file-explorer": "0.2.1",
    "@lapis-notes/markdown": "0.2.1",
    "@lapis-notes/search": "0.1.4",
    "@lapis-notes/ui": "0.1.6",
    "@lapis-notes/workspace": "0.3.2",
    "@lapismd/design-core": "0.9.0",
    "@lapismd/mira": "0.1.3",
    "@lapismd/spec-validator": "^0.2.0",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/lr": "1.4.10",
    "@lezer/markdown": "1.7.2",
    "@observablehq/plot": "0.6.17",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/svelte-vite": "10.6.5",
    "@sveltejs/package": "2.5.0",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/vite": "4.1.12",
    "@tsconfig/svelte": "5.0.5",
    "@types/node": "^22.15.0",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "aria-query": "5.3.2",
    "bits-ui": "2.20.2",
    "d3": "7.9.0",
    "htl": "0.3.1",
    "playwright": "1.64.1",
    "publint": "0.3.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rollup": "^4.67.2",
    "rollup-plugin-dts": "^6.5.1",
    "storybook": "10.6.5",
    "svelte": "5.56.10",
    "svelte-check": "4.3.1",
    "tailwindcss": "4.1.12",
    "turbo": "^2.11.10",
    "typescript": "~5.8.3",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "fflate": "^0.8.3",
    "es-module-lexer": "^1.7.0",
    "sharp": "0.35.5",
    "@fontsource-variable/inter": "5.3.0",
    "@lapismd/storybook-addon-visual-delta": "0.0.7"
  }
}
